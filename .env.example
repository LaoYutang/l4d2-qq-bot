# QQ 官方应用凭据；不要提交真实值。
L4D2_APP_ID=
L4D2_CLIENT_SECRET=
# 配置界面密码：浏览器 localStorage 保存原值，通过 X-Config-Password 请求头发送。
# 错误密码按连接 IP 限流：容量 5 次，每 60 秒恢复 1 次；耗尽后返回 429 和等待秒数。
L4D2_WEB_PASSWORD=
L4D2_WEB_HOST=0.0.0.0
L4D2_WEB_PORT=8080
# 使用 Actions 发布的 Docker Hub 镜像时取消注释，并按需固定版本；配合 compose up --no-build。
# L4D2_IMAGE=laoyutang/l4d2-qq-bot:latest
# 2026-08 起官方 API 域名统一为 api.bot.qq.com。
L4D2_API_BASE=https://api.bot.qq.com
L4D2_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken
L4D2_CONFIG_PATH=config.json
L4D2_LOG_LEVEL=INFO
# 留空自动寻找系统中文字体；Docker 已安装 Noto CJK。
L4D2_CARD_FONT_PATH=
# 默认用现有正文排版 QQ 原生 Markdown 卡片，按钮挂在同一条消息底部。
# ID、未配置、错误及管理操作提示使用普通文本，不加标题或加粗。
# 改成 image 可使用 PNG 查询图片，补充文字使用普通文本。
L4D2_REPLY_FORMAT=markdown
# 自定义按钮需要应用具有相应权限；被平台拒绝时会明确提示。
L4D2_CONNECT_BUTTONS=true
# 仅在有需要时修改超时、业务 worker 与队列大小。
L4D2_HTTP_TIMEOUT_SECONDS=20
L4D2_COMMAND_TIMEOUT_SECONDS=120
L4D2_WORKER_COUNT=2
L4D2_EVENT_QUEUE_SIZE=100
# 兼容旧部署的黑盒凭据；新部署在配置界面填写，可留空。
L4D2_HEYBOX_BOT_ID=
L4D2_HEYBOX_TOKEN=
