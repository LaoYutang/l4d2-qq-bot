# QQ 官方应用凭据；不要提交真实值。
L4D2_APP_ID=
L4D2_CLIENT_SECRET=
# 2026-08 起官方 API 域名统一为 api.bot.qq.com。
L4D2_API_BASE=https://api.bot.qq.com
L4D2_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken
L4D2_CONFIG_PATH=config.json
L4D2_LOG_LEVEL=INFO
# 留空自动寻找系统中文字体；Docker 已安装 Noto CJK。
L4D2_CARD_FONT_PATH=
# 默认一条 QQ 原生 Markdown 卡片，按钮挂在同一条消息底部。
# 改成 image 可使用 PNG 图片回复。
L4D2_REPLY_FORMAT=markdown
# 自定义按钮需要应用具有相应权限；被平台拒绝时会明确提示。
L4D2_CONNECT_BUTTONS=true
# 仅在有需要时修改超时、业务 worker 与队列大小。
L4D2_HTTP_TIMEOUT_SECONDS=20
L4D2_COMMAND_TIMEOUT_SECONDS=120
L4D2_WORKER_COUNT=2
L4D2_EVENT_QUEUE_SIZE=100
# 黑盒语音：还需配置本群 hh_room_id 与服务器 hh_channel_id。
L4D2_HEYBOX_BOT_ID=
L4D2_HEYBOX_TOKEN=
